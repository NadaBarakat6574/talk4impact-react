rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chat/{conversationId}/{senderId}/{messageId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == senderId
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
